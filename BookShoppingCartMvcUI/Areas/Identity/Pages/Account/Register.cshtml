@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto py-12">
    <div class="text-center mb-10">
        <div class="w-16 h-16 bg-indigo-600 rounded-3xl flex items-center justify-center shadow-xl shadow-indigo-100 text-white mx-auto mb-4">
            <i class="bi bi-person-plus text-3xl"></i>
        </div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Create Account</h1>
        <p class="text-slate-500 font-medium mt-2">Join our community of book lovers</p>
    </div>

    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50 p-8 space-y-6">
        <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-2xl text-xs font-bold text-rose-600 uppercase tracking-wider" role="alert"></div>
        
        <div class="flex flex-col gap-2">
            <label asp-for="Input.Email" class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Email Address</label>
            <div class="relative">
                <i class="bi bi-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input asp-for="Input.Email" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="name@example.com" />
            </div>
            <span asp-validation-for="Input.Email" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
        </div>

        <div class="flex flex-col gap-2">
            <label asp-for="Input.Password" class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Password</label>
            <div class="relative">
                <i class="bi bi-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input asp-for="Input.Password" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Input.Password" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
        </div>

        <div class="flex flex-col gap-2">
            <label asp-for="Input.ConfirmPassword" class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Confirm Password</label>
            <div class="relative">
                <i class="bi bi-shield-check absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input asp-for="Input.ConfirmPassword" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
        </div>

        <button id="registerSubmit" type="submit" class="w-full py-4 bg-indigo-600 text-white rounded-2xl font-black hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all active:scale-95">
            Create Account
        </button>

        <div class="pt-6 border-t border-slate-100 text-center">
            <p class="text-sm text-slate-500">
                Already have an account? 
                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="font-bold text-indigo-600 hover:text-indigo-700 transition-colors">Sign in</a>
            </p>
        </div>
    </form>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="mt-8">
            <div class="relative flex items-center justify-center mb-6">
                <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
                <span class="relative px-4 bg-slate-50 text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]">Or join with</span>
            </div>
            
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="flex flex-col gap-3">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" name="provider" value="@provider.Name" 
                            class="flex items-center justify-center gap-3 w-full py-3 bg-white border border-slate-200 rounded-xl text-sm font-bold text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all">
                        <i class="bi bi-@(provider.DisplayName?.ToLower() ?? "shield-check") text-lg"></i>
                        Register with @provider.DisplayName
                    </button>
                }
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
