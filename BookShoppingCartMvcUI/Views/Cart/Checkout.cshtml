@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="max-w-2xl mx-auto py-12">
    <div class="flex items-center gap-3 mb-8">
        <div class="w-12 h-12 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-100 text-white">
            <i class="bi bi-credit-card text-2xl"></i>
        </div>
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">Checkout</h1>
            <p class="text-sm text-slate-500 font-medium">Please provide your shipping and payment details</p>
        </div>
    </div>

    <form asp-action="Checkout" class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-200/50 overflow-hidden">
        <div class="p-8 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="flex flex-col gap-2">
                    <label asp-for="Name" class="text-xs font-bold text-slate-500 uppercase tracking-widest">Full Name*</label>
                    <input type="text" asp-for="Name" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="John Doe" />
                    <span asp-validation-for="Name" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
                </div>

                <div class="flex flex-col gap-2">
                    <label asp-for="Email" class="text-xs font-bold text-slate-500 uppercase tracking-widest">Email Address*</label>
                    <input type="text" asp-for="Email" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="john@example.com" />
                    <span asp-validation-for="Email" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="MobileNumber" class="text-xs font-bold text-slate-500 uppercase tracking-widest">Mobile Number*</label>
                <div class="relative">
                    <i class="bi bi-phone absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" asp-for="MobileNumber" class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="+1 (555) 000-0000" />
                </div>
                <span asp-validation-for="MobileNumber" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="Address" class="text-xs font-bold text-slate-500 uppercase tracking-widest">Shipping Address*</label>
                <textarea asp-for="Address" rows="4" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="123 Street Name, City, Country"></textarea>
                <span asp-validation-for="Address" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
            </div>

            <div class="flex flex-col gap-2">
                <label asp-for="PaymentMethod" class="text-xs font-bold text-slate-500 uppercase tracking-widest">Payment Method*</label>
                <select asp-for="PaymentMethod" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900 appearance-none cursor-pointer">
                    <option value="">Select Payment Method</option>
                    @foreach (var method in Enum.GetValues(typeof(BookShoppingCartMvcUI.Constants.PaymentMethods)))
                    {
                        <option value="@method.ToString()">@method.ToString()</option>
                    }
                </select>
                <span asp-validation-for="PaymentMethod" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
            </div>
        </div>

        <div class="bg-slate-50 p-8 border-t border-slate-100 flex items-center justify-between">
            <a href="/Cart/GetUserCart" class="text-sm font-bold text-slate-500 hover:text-slate-700 transition-colors">
                <i class="bi bi-arrow-left"></i> Back to Cart
            </a>
            <button type="submit" class="px-10 py-4 bg-indigo-600 text-white rounded-2xl font-black hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all active:scale-95">
                Complete Order <i class="bi bi-check2-all ml-1"></i>
            </button>
        </div>
    </form>
</div>