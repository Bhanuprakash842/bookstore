@model ShoppingCart
@{
    ViewData["Title"] = "My Shopping Cart";
}

<div class="max-w-6xl mx-auto py-8">
    <div class="flex items-center gap-3 mb-8">
        <div class="w-12 h-12 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-100 text-white">
            <i class="bi bi-cart-check text-2xl"></i>
        </div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Your Shopping Cart</h1>
    </div>

    @if (Model != null && Model.CartDetails != null && Model.CartDetails.Count > 0)
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Cart Items -->
            <div class="lg:col-2 space-y-4">
                @foreach (var item in Model.CartDetails)
                {
                    <div class="flex items-center gap-6 p-6 bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                        <!-- Product Image -->
                        <div class="w-24 h-32 bg-slate-50 rounded-2xl overflow-hidden flex-shrink-0 border border-slate-100">
                            @if (string.IsNullOrEmpty(item.Book.Image))
                            {
                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                    <i class="bi bi-image text-2xl"></i>
                                </div>
                            }
                            else
                            {
                                <img src="/images/@item.Book.Image" class="w-full h-full object-cover" />
                            }
                        </div>

                        <!-- Product Info -->
                        <div class="flex-grow">
                            <div class="flex justify-between items-start">
                                <div>
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-indigo-500 mb-1 block">@item.Book.Genre.GenreName</span>
                                    <h3 class="text-lg font-bold text-slate-900 mb-1">@item.Book.BookName</h3>
                                    <p class="text-sm text-slate-500">By Premium Author</p>
                                </div>
                                <div class="text-right">
                                    <p class="text-lg font-black text-slate-900">$@(item.Book.Price * item.Quantity)</p>
                                    <p class="text-xs text-slate-400 font-medium">$@item.Book.Price each</p>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="flex items-center justify-between mt-6">
                                <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
                                    <a href="/cart/removeitem?bookid=@item.BookId" class="w-8 h-8 flex items-center justify-center text-slate-600 hover:bg-white hover:text-indigo-600 rounded-lg transition-all">
                                        <i class="bi bi-dash-lg"></i>
                                    </a>
                                    <span class="w-12 text-center font-bold text-slate-800 text-sm">@item.Quantity</span>
                                    @if (item.Quantity < item.Book.Stock.Quantity)
                                    {
                                        <a href="/Cart/AddItem?bookId=@item.BookId&&redirect=1" class="w-8 h-8 flex items-center justify-center text-slate-600 hover:bg-white hover:text-indigo-600 rounded-lg transition-all">
                                            <i class="bi bi-plus-lg"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="w-8 h-8 flex items-center justify-center text-rose-300 cursor-not-allowed">
                                            <i class="bi bi-plus-lg"></i>
                                        </span>
                                    }
                                </div>

                                <a href="/cart/removeitem?bookid=@item.BookId" class="text-xs font-bold text-rose-500 hover:text-rose-700 transition-colors uppercase tracking-wider">
                                    <i class="bi bi-trash3 mr-1"></i> Remove
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Summary Sidebar -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-200/50 p-8 sticky top-24">
                    <h2 class="text-xl font-bold text-slate-900 mb-6">Order Summary</h2>
                    
                    <div class="space-y-4 mb-6">
                        <div class="flex justify-between text-slate-500">
                            <span class="text-sm">Subtotal</span>
                            <span class="font-bold text-slate-900">$@(Model.CartDetails.Sum(i => i.Book.Price * i.Quantity))</span>
                        </div>
                        <div class="flex justify-between text-slate-500">
                            <span class="text-sm">Shipping</span>
                            <span class="text-emerald-600 font-bold">Free</span>
                        </div>
                        <div class="h-px bg-slate-100 my-4"></div>
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-bold text-slate-900">Total</span>
                            <span class="text-2xl font-black text-indigo-600 tracking-tight">$@(Model.CartDetails.Sum(i => i.Book.Price * i.Quantity))</span>
                        </div>
                    </div>

                    <a href="/Cart/Checkout" class="w-full py-4 bg-indigo-600 text-white rounded-2xl font-bold flex items-center justify-center gap-2 hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all active:scale-95 mb-4">
                        Proceed to Checkout <i class="bi bi-arrow-right"></i>
                    </a>
                    
                    <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                        <i class="bi bi-shield-check text-2xl text-emerald-500"></i>
                        <p class="text-[10px] text-slate-500 font-medium leading-tight">
                            Your payment information is encrypted and secure. 100% money-back guarantee.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-24 bg-white rounded-3xl border border-dashed border-slate-200 shadow-sm">
            <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                <i class="bi bi-cart-x text-5xl text-slate-200"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Your cart is empty</h2>
            <p class="text-slate-500 mb-8">Looks like you haven't added anything to your cart yet.</p>
            <a href="/Home/Index" class="inline-flex items-center gap-2 px-8 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition-all">
                <i class="bi bi-shop"></i> Start Shopping
            </a>
        </div>
    }
</div>

