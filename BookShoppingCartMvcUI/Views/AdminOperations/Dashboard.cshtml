@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="flex flex-col gap-8">
    <!-- Welcome Hero -->
    <div class="bg-indigo-600 rounded-3xl p-8 text-white shadow-xl shadow-indigo-200 relative overflow-hidden">
        <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
        <div class="relative z-10">
            <h1 class="text-3xl font-black mb-2 tracking-tight">Welcome back, @User.Identity?.Name!</h1>
            <p class="text-indigo-100 font-medium">Here's what's happening with your bookstore today.</p>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 mb-4">
                <i class="bi bi-currency-dollar text-2xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Total Revenue</p>
            <h3 class="text-2xl font-black text-slate-900">$12,845.00</h3>
            <p class="text-xs text-emerald-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-graph-up-arrow"></i> +12% from last month
            </p>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 mb-4">
                <i class="bi bi-cart-check text-2xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Total Orders</p>
            <h3 class="text-2xl font-black text-slate-900">156</h3>
            <p class="text-xs text-indigo-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-bag-check"></i> 24 pending orders
            </p>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600 mb-4">
                <i class="bi bi-book text-2xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">Total Books</p>
            <h3 class="text-2xl font-black text-slate-900">428</h3>
            <p class="text-xs text-amber-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-plus-circle"></i> 12 added this week
            </p>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm">
            <div class="w-12 h-12 bg-rose-50 rounded-2xl flex items-center justify-center text-rose-600 mb-4">
                <i class="bi bi-people text-2xl"></i>
            </div>
            <p class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-1">New Customers</p>
            <h3 class="text-2xl font-black text-slate-900">84</h3>
            <p class="text-xs text-rose-600 font-bold mt-2 flex items-center gap-1">
                <i class="bi bi-person-plus"></i> +5% conversion rate
            </p>
        </div>
    </div>

    <!-- Recent Activity Placeholder -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-8">
        <h3 class="text-lg font-black text-slate-900 mb-6 tracking-tight">Recent System Activity</h3>
        <div class="flex flex-col gap-6">
            <div class="flex gap-4">
                <div class="w-2 h-2 bg-indigo-600 rounded-full mt-2 flex-shrink-0"></div>
                <div>
                    <p class="text-sm font-bold text-slate-800">New order placed by John Doe</p>
                    <p class="text-xs text-slate-400">2 minutes ago</p>
                </div>
            </div>
            <div class="flex gap-4">
                <div class="w-2 h-2 bg-emerald-500 rounded-full mt-2 flex-shrink-0"></div>
                <div>
                    <p class="text-sm font-bold text-slate-800">Payment received for order #ORD-128</p>
                    <p class="text-xs text-slate-400">15 minutes ago</p>
                </div>
            </div>
             <div class="flex gap-4">
                <div class="w-2 h-2 bg-amber-400 rounded-full mt-2 flex-shrink-0"></div>
                <div>
                    <p class="text-sm font-bold text-slate-800">Low stock alert: "Clean Code" by Robert C. Martin</p>
                    <p class="text-xs text-slate-400">1 hour ago</p>
                </div>
            </div>
        </div>
    </div>
</div>

