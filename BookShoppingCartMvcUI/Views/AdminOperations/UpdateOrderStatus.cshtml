@model UpdateOrderStatusModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Update Order Status";
}

<div class="max-w-md">
    <div class="flex items-center gap-3 mb-8">
        <a asp-action="AllOrders" class="w-10 h-10 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-500 hover:text-indigo-600 hover:border-indigo-100 transition-all">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Update Order Status</h1>
            <p class="text-sm text-slate-500 font-medium">Change the current status of order #@Model.OrderId</p>
        </div>
    </div>

    <form asp-action="UpdateOrderStatus" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <input type="hidden" asp-for="OrderId" />
        <div class="p-8 space-y-6">
            <div class="flex flex-col gap-2">
                <label asp-for="OrderStatusId" class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Current Status*</label>
                <select asp-for="OrderStatusId" asp-items="@Model.OrderStatusList" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900 appearance-none cursor-pointer">
                    <option value="">Select Order Status</option>
                </select>
                <span asp-validation-for="OrderStatusId" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
            </div>

            @if (TempData["msg"] != null)
            {
                <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-2xl flex items-center gap-3 text-emerald-700">
                    <i class="bi bi-check-circle-fill"></i>
                    <p class="text-xs font-bold uppercase tracking-wider">@TempData["msg"]</p>
                </div>
            }
        </div>

        <div class="bg-slate-50 p-8 border-t border-slate-100 flex justify-end">
            <button type="submit" class="px-8 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all active:scale-95">
                Update Status
            </button>
        </div>
    </form>
</div>

