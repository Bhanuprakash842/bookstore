@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-3xl mx-auto py-12">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-12">
        <h1 class="text-3xl font-black text-slate-900 mb-6 tracking-tight">Privacy Policy</h1>
        <div class="prose prose-slate max-w-none">
            <p class="text-slate-600 leading-relaxed">
                Your privacy is important to us. It is EBookStore's policy to respect your privacy regarding any information we may collect from you across our website.
            </p>
            <h2 class="text-xl font-bold text-slate-800 mt-8 mb-4">Information we collect</h2>
            <p class="text-slate-600 leading-relaxed mb-4">
                We only ask for personal information when we truly need it to provide a service to you. We collect it by fair and lawful means, with your knowledge and consent. We also let you know why we’re collecting it and how it will be used.
            </p>
            <p class="text-slate-600 leading-relaxed">
                We only retain collected information for as long as necessary to provide you with your requested service. What data we store, we’ll protect within commercially acceptable means to prevent loss and theft, as well as unauthorized access, disclosure, copying, use or modification.
            </p>
        </div>
    </div>
</div>
