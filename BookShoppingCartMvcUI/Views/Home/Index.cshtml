@model BookDisplayModel

<!-- Hero Section -->
<div class="relative overflow-hidden bg-white rounded-3xl shadow-xl shadow-indigo-100/50 mb-12 border border-slate-100">
    <div class="absolute top-0 right-0 -translate-y-1/4 translate-x-1/4 w-96 h-96 bg-indigo-50 rounded-full blur-3xl opacity-50"></div>
    <div class="relative px-8 py-12 md:py-16 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="max-w-xl">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
                Discover Your Next <span class="text-indigo-600">Great Adventure</span>
            </h1>
            <p class="text-lg text-slate-600 mb-8 leading-relaxed">
                Explore thousands of books from world-class authors. From timeless classics to the latest bestsellers, find your perfect match here.
            </p>
            
            <!-- Search & Filter Bar -->
            <form asp-action="Index" class="flex flex-col sm:flex-row gap-3 p-2 bg-slate-50 rounded-2xl border border-slate-200 shadow-sm">
                <div class="relative flex-grow">
                    <i class="bi bi-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" value="@Model.STerm" id="sterm" name="sterm" 
                           class="w-full pl-11 pr-4 py-3 bg-transparent border-none focus:ring-0 text-slate-900 placeholder:text-slate-400 font-medium" 
                           placeholder="Search by title, author...">
                </div>
                
                <div class="flex gap-2">
                    <select class="pl-4 pr-10 py-3 bg-white rounded-xl border border-slate-200 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 appearance-none cursor-pointer" 
                            id="genreId" name="genreId">
                        <option value="">All Genres</option>
                        @foreach (var genre in Model.Genres)
                        {
                            <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                        }
                    </select>
                    
                    <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 transition-all shadow-lg shadow-indigo-200 active:scale-95">
                        Search
                    </button>
                    <a href="/Home/Index" class="p-3 bg-slate-200 text-slate-600 rounded-xl hover:bg-slate-300 transition-all">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
        <div class="hidden lg:block w-72 h-96 relative">
             <div class="absolute inset-0 bg-indigo-600 rounded-2xl rotate-6 opacity-10"></div>
             <div class="absolute inset-0 bg-white border border-slate-100 rounded-2xl shadow-2xl flex items-center justify-center p-6 -rotate-3 overflow-hidden">
                <i class="bi bi-book-half text-[180px] text-indigo-50 opacity-50 absolute"></i>
                <div class="relative z-10 text-center">
                    <div class="w-16 h-2 bg-indigo-600 mx-auto mb-4 rounded-full"></div>
                    <p class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-2">Editor's Choice</p>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">The Art of Modern Web</h3>
                    <p class="text-sm text-slate-500 italic">By Premium Authors</p>
                </div>
             </div>
        </div>
    </div>
</div>

<!-- Books Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
    @foreach (var book in Model.Books)
    {
        <div class="group relative bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
            <!-- Image Container -->
            <div class="aspect-[3/4] overflow-hidden bg-slate-50">
                @if (string.IsNullOrEmpty(book.Image))
                {
                    <div class="w-full h-full flex flex-col items-center justify-center text-slate-300">
                        <i class="bi bi-image text-4xl mb-2"></i>
                        <span class="text-xs font-medium">No Cover Available</span>
                    </div>
                }
                else
                {
                    <img src="/images/@book.Image" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="@book.BookName">
                }
                
                <!-- Genre Tag -->
                <div class="absolute top-3 left-3">
                    <span class="px-2.5 py-1 bg-white/90 backdrop-blur-sm border border-slate-200 text-[10px] font-bold uppercase tracking-wider text-slate-600 rounded-lg shadow-sm">
                        @book.GenreName
                    </span>
                </div>
            </div>

            <!-- Content -->
            <div class="p-5">
                <div class="mb-3">
                    <p class="text-xs font-semibold text-indigo-500 uppercase tracking-wider mb-1">@book.AuthorName</p>
                    <h3 class="text-lg font-bold text-slate-900 line-clamp-1 group-hover:text-indigo-600 transition-colors">@book.BookName</h3>
                </div>
                
                <div class="flex items-center justify-between mt-6">
                    <div class="flex flex-col">
                        <span class="text-xs text-slate-400 font-medium">Price</span>
                        <span class="text-xl font-black text-slate-900">$@book.Price</span>
                    </div>

                    @if (book.Quantity > 0)
                    {
                        <button type="button" onclick="add(@book.Id)" 
                                class="flex items-center gap-2 px-4 py-2 bg-slate-900 text-white text-sm font-bold rounded-xl hover:bg-indigo-600 transition-colors">
                            <i class="bi bi-cart-plus"></i> Add
                        </button>
                    }
                    else
                    {
                        <span class="px-3 py-1.5 bg-rose-50 text-rose-600 text-[10px] font-bold uppercase tracking-wider rounded-lg border border-rose-100">
                            Sold Out
                        </span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts{
    <script>
        async function add(bookId) {
             var usernameEl = document.getElementById("username");
             if(usernameEl == null){
                window.location.href = "/Identity/Account/Login";
                return;
             }
            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    if(cartCountEl) {
                        cartCountEl.innerHTML = result;
                        // Bounce animation for cart
                        cartCountEl.parentElement.classList.add('scale-125', 'text-indigo-600');
                        setTimeout(() => cartCountEl.parentElement.classList.remove('scale-125', 'text-indigo-600'), 300);
                    }
                }
            } catch (err) {
                console.log(err);
            }
        }
    </script>
}


