@model StockDTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Stock";
}

<div class="max-w-md">
    <div class="flex items-center gap-3 mb-8">
        <a asp-action="Index" asp-controller="Stock" class="w-10 h-10 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-500 hover:text-indigo-600 hover:border-indigo-100 transition-all">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="text-2xl font-black text-slate-900 tracking-tight">Manage Stock</h1>
            <p class="text-sm text-slate-500 font-medium">Update inventory levels for this book</p>
        </div>
    </div>

    <form asp-action="ManangeStock" class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
        <input type="hidden" asp-for="BookId" />
        <div class="p-8 space-y-6">
            <div class="flex flex-col gap-2">
                <label asp-for="Quantity" class="text-xs font-bold text-slate-500 uppercase tracking-widest px-1">Current Stock Quantity*</label>
                <input type="number" asp-for="Quantity" class="px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all font-medium text-slate-900" placeholder="e.g. 50" />
                <span asp-validation-for="Quantity" class="text-[10px] font-bold text-rose-500 uppercase tracking-wider"></span>
            </div>
        </div>

        <div class="bg-slate-50 p-8 border-t border-slate-100 flex justify-end">
            <button type="submit" class="px-8 py-3 bg-indigo-600 text-white rounded-xl font-bold hover:bg-indigo-700 shadow-lg shadow-indigo-100 transition-all active:scale-95">
                Update Stock
            </button>
        </div>
    </form>
</div>
